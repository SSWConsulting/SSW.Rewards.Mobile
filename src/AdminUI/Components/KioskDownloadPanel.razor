@using QRCoder

@if (Compact)
{
    <div class="kiosk-download-qr-compact @Class">
        <div class="kiosk-compact-qr-shell">
            <img src="@_qrDataUri" alt="Download SSW Rewards app" />
        </div>
        <span class="kiosk-compact-title">Get the mobile app</span>
        <MudLink Href="@Url"
                 Target="_blank"
                 Rel="noopener noreferrer"
                 Class="kiosk-compact-link">
            @DisplayUrl
        </MudLink>
    </div>
}
else
{
    <aside class="kiosk-download-panel @Class">
        <MudText Typo="Typo.h6" Class="kiosk-download-panel-title">Get The App In One Scan</MudText>
        <MudText Typo="Typo.caption" Class="kiosk-download-panel-subtitle">
            Smart link auto-redirects to App Store or Google Play
        </MudText>
        <div class="kiosk-download-qr-shell">
            <img src="@_qrDataUri" alt="Download SSW Rewards app" class="kiosk-download-qr" />
        </div>
        <MudLink Href="@Url"
                 Target="_blank"
                 Rel="noopener noreferrer"
                 Typo="Typo.caption"
                 Class="kiosk-download-link">
            @DisplayUrl
        </MudLink>
    </aside>
}

@code {
    [Parameter]
    public string Url { get; set; } = "https://rewards.ssw.com.au/download/app";

    [Parameter]
    public string DisplayUrl { get; set; } = "rewards.ssw.com.au/download/app";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    private string _qrDataUri = string.Empty;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Url))
        {
            return;
        }

        using var qrGenerator = new QRCodeGenerator();
        using var qrCodeData = qrGenerator.CreateQrCode(Url, QRCodeGenerator.ECCLevel.Q);
        using var qrCode = new PngByteQRCode(qrCodeData);
        var pngBytes = qrCode.GetGraphic(5);
        _qrDataUri = $"data:image/png;base64,{Convert.ToBase64String(pngBytes)}";
    }
}
