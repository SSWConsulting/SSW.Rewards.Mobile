@layout KioskLayout
@page "/kiosk-leaderboard"

@using SSW.Rewards.Shared.DTOs.Leaderboard
@using SSW.Rewards.Admin.UI.Components

@inject SSW.Rewards.ApiClient.Services.ILeaderboardService leaderboardService

<MudPaper Class="kiosk-leaderboard" Style="padding: 1.5rem 2rem 1rem; min-height: 100vh; background: #121212; color: #fafafa;">
    <div class="kiosk-header">
        <div class="kiosk-header-center">
            <MudImage Src="/images/ssw-rewards-logo.svg" Style="height: 60px;" />
            <MudText Typo="Typo.caption" Class="kiosk-tagline">
                Scan QR codes, earn points, win prizes!
            </MudText>
        </div>
        <KioskDownloadPanel Compact="true" Class="kiosk-header-qr" />
    </div>
    <div style="display: flex; justify-content: center; align-items: center; margin-bottom: 0.25rem;">
        <div style="width: 600px; max-width: 100%;">
            <MudTabs Rounded="true" Centered="true" Class="kiosk-tabs" Style="background: transparent; box-shadow: none; width: 100%;" ActivePanelIndex="@_activeTabIndex">
                <MudTabPanel Text="Week" OnClick="eventArgs => OnTabChanged(0)" />
                <MudTabPanel Text="Month" OnClick="eventArgs => OnTabChanged(1)" />
                <MudTabPanel Text="Year" OnClick="eventArgs => OnTabChanged(2)" />
                <MudTabPanel Text="All Time" OnClick="eventArgs => OnTabChanged(3)" />
            </MudTabs>
        </div>
    </div>
    <div class="kiosk-table-wrapper">
        <div style="width: 600px; max-width: 100%;">
            <MudTable @ref="table" TItem="MobileLeaderboardUserDto" ServerData="@ServerReload" FixedHeader="true" Dense="false" Hover="true" Bordered="false" Striped="false" Class="kiosk-leaderboard-table" Style="border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.3); overflow: hidden; background: #181818;" RowsPerPage="@_resolvedPageSize">
                <HeaderContent>
                    <MudTh Style="width: 80px; text-align: center;">Rank</MudTh>
                    <MudTh Style="width: 320px;">Name</MudTh>
                    <MudTh Style="width: 160px; text-align: center;">Points</MudTh>
                </HeaderContent>
                <NoRecordsContent>
                    <MudText Typo="Typo.body1" Align="Align.Center" Style="padding: 2rem; color: #aaa;">
                        No one has earned points @GetPeriodLabel() — be the first!
                    </MudText>
                </NoRecordsContent>
                <RowTemplate Context="row">
                    <MudTd Style="width: 80px; text-align: center;" DataLabel="Rank">@row.Rank</MudTd>
                    <MudTd Style="width: 320px;" DataLabel="Name">
                        <div class="d-flex flex-nowrap gap-2 align-center">
                            <Avatar Url="@row.ProfilePic" />
                            <div class="kiosk-user-meta">
                                <MudText Typo="Typo.body1">@row.Name</MudText>
                                @if (!string.IsNullOrWhiteSpace(row.XHandle))
                                {
                                    <MudText Typo="Typo.caption" Class="kiosk-x-handle">@($"@{row.XHandle}")</MudText>
                                }
                            </div>
                            @if (row.Rank == 1)
                            {
                                <MudText Typo="Typo.body1">&#x1F451;</MudText>
                            }
                        </div>
                    </MudTd>
                    <MudTd Style="width: 160px; text-align: center;" DataLabel="Points">@row.Points.ToString("N0")</MudTd>
                </RowTemplate>
                <PagerContent></PagerContent>
            </MudTable>
            @if (_totalPages > 1)
            {
                <div class="scroll-progress-container">
                    <div class="scroll-progress-bar" style="width: @(_scrollProgress.ToString("F1"))%;"></div>
                </div>
            }
        </div>
    </div>
    @* Preload profile images to prevent flickering and re-downloading on page
       changes — the kiosk re-renders the table every 10s (scroll) and 60s (refresh),
       and external image hosts have inconsistent caching rules. These hidden imgs
       keep images in the browser's memory cache so MudAvatar loads them instantly. *@
    <div style="display:none;" aria-hidden="true">
        @foreach (var url in _preloadedImageUrls)
        {
            <img src="@url" @key="url" />
        }
    </div>
    <div class="kiosk-refresh-info @(_hasErrorsOnUpdate ? "kiosk-refresh-error" : "")">
        @if (_hasErrorsOnUpdate)
        {
            <span>Could not refresh. Retrying in @_secondsUntilRefresh seconds.</span>
        }
        else
        {
            <span>Last refreshed: @GetLastRefreshedDateText()</span>
            <span>Refreshing in @_secondsUntilRefresh s</span>
        }
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Size="Size.Small"
                   Disabled="@_isRefreshingNow"
                   OnClick="UpdateNowAsync"
                   Class="kiosk-update-now-btn">
            Update now
        </MudButton>
    </div>
</MudPaper>
