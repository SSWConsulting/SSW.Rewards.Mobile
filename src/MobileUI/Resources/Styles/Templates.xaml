<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                    xmlns:resolver="clr-namespace:Maui.Plugins.PageResolver;assembly=Maui.Plugins.PageResolver"
                    xmlns:vm="clr-namespace:SSW.Rewards.Mobile.ViewModels"
                    xmlns:common="clr-namespace:SSW.Rewards.Mobile.Common">
    <ControlTemplate x:Key="PageTemplate">
        <Grid RowDefinitions="50,Auto,*"
              Margin="0"
              Padding="0">
            <Grid.BindingContext>
                <resolver:ResolveViewModel x:TypeArguments="vm:TopBarViewModel" />
            </Grid.BindingContext>
            <Grid Grid.Row="0"
                  ColumnDefinitions="50,*,50"
                  HeightRequest="50"
                  Padding="10,5"
                  BackgroundColor="{StaticResource Background}"
                  VerticalOptions="Start"
                  x:DataType="vm:TopBarViewModel">
                <!-- Wrapping AvatarView in a Grid where IsVisible can be toggled to work around 
                     an odd animation that happens on iOS
                     See bug: https://github.com/SSWConsulting/SSW.Rewards.Mobile/issues/918 -->
                <Grid Grid.Column="0"
                      IsVisible="True"
                      HeightRequest="40"
                      WidthRequest="40"
                      VerticalOptions="Center">
                    <mct:AvatarView ImageSource="{Binding ProfilePic}"
                                    HeightRequest="40"
                                    WidthRequest="40"
                                    CornerRadius="20"
                                    BorderColor="White"
                                    BorderWidth="2">
                        <mct:AvatarView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFlyoutCommand}" />
                        </mct:AvatarView.GestureRecognizers>
                    </mct:AvatarView>
                    <Grid.Triggers>
                        <DataTrigger x:DataType="common:BaseContentPage"
                                     TargetType="Grid"
                                     Binding="{Binding Source={RelativeSource TemplatedParent}, Path=ShowBackButton}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Grid.Triggers>
                </Grid>

                <Button
                    Grid.Column="0"
                    HeightRequest="40"
                    WidthRequest="40"
                    CornerRadius="20"
                    MinimumHeightRequest="40"
                    MinimumWidthRequest="40"
                    BorderWidth="2"
                    BorderColor="White"
                    BackgroundColor="{StaticResource SSWRed}"
                    Padding="0"
                    IsVisible="False"
                    Command="{Binding GoBackCommand}"
                    VerticalOptions="Center">
                    <Button.Triggers>
                        <DataTrigger x:DataType="common:BaseContentPage"
                                     TargetType="Button"
                                     Binding="{Binding Source={RelativeSource TemplatedParent}, Path=ShowBackButton}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Button.Triggers>
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FluentIcons"
                                         Glyph="&#xf189;"
                                         Size="22"
                                         Color="White"/>
                    </Button.ImageSource>
                </Button>
                
                <Image Grid.Column="1"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       HeightRequest="40"
                       Source="ssw_logo_darkmode"
                       x:DataType="common:BaseContentPage"
                       IsVisible="{Binding Source={RelativeSource TemplatedParent}, Path=Title, Converter={mct:IsStringNullOrEmptyConverter}}"/>
                
                <Grid Grid.Column="1"
                      VerticalOptions="Center"
                      HeightRequest="50">
                    <Label x:DataType="common:BaseContentPage"
                           Text="{Binding Source={RelativeSource TemplatedParent}, Path=Title}"
                           Style="{StaticResource LabelBold}"
                           FontSize="18"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </Grid>
                
                <Button
                    Grid.Column="2"
                    HeightRequest="40"
                    WidthRequest="40"
                    MinimumHeightRequest="40"
                    MinimumWidthRequest="40"
                    CornerRadius="20"
                    BorderWidth="2"
                    BorderColor="White"
                    BackgroundColor="{StaticResource FlyoutBackgroundColour}"
                    Padding="0"
                    Command="{Binding OpenActivityPageCommand}"
                    IsVisible="True"
                    VerticalOptions="Center">
                    <Button.Triggers>
                        <DataTrigger x:DataType="common:BaseContentPage"
                                     TargetType="Button"
                                     Binding="{Binding Source={RelativeSource TemplatedParent}, Path=ShowBackButton}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                    <Button.ImageSource>
                        <FileImageSource File="icon_bell" />
                    </Button.ImageSource>
                </Button>
            </Grid>
            <!-- Offline banner (#1567): shown while the device is offline; the row collapses when hidden.
                 Anything on screen while offline came from the cache, hence "showing saved data". -->
            <Grid Grid.Row="1"
                  x:DataType="vm:TopBarViewModel"
                  IsVisible="{Binding Connectivity.IsOffline}"
                  BackgroundColor="{StaticResource Gray600}"
                  HorizontalOptions="Fill"
                  Padding="12,6"
                  SemanticProperties.Description="You're offline. Showing saved data.">
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <!-- fa-plug -->
                    <Label Text="&#xf1e6;"
                           FontFamily="FA6Solid"
                           FontSize="13"
                           TextColor="White"
                           VerticalOptions="Center" />
                    <Label Text="You're offline · showing saved data"
                           FontSize="13"
                           TextColor="White"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
            <ContentPresenter Grid.Row="2" />
        </Grid>
    </ControlTemplate>

</ResourceDictionary>